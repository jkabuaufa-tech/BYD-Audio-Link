{
  "name": "seps-desktop",
  "productName": "SEPS",
  "version": "1.0.0",
  "description": "SEPS — Sistem Evaluasi & Produksi Swakelola (aplikasi desktop)",
  "author": "SEPS",
  "main": "main.js",
  "private": true,
  "scripts": {
    "siapkan": "node ../alat/rakit-kode.js kode",
    "start": "npm run siapkan && electron .",
    "dist:win": "npm run siapkan && electron-builder --win nsis --publish never",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "sql.js": "1.12.0"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "id.seps.desktop",
    "productName": "SEPS",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "pemilih-kode.js", "package.json", "kode/**/*", "node_modules/**/*"],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SEPS",
      "artifactName": "SEPS-Setup-${version}.${ext}"
    }
  }
}
